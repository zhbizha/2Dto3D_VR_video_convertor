<Window x:Class="VRify.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:VRify.App.Resources"
        Title="{x:Static res:Strings.WindowTitle}" Height="640" Width="900"
        Background="#1E1E2E" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#6C7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#89B4FA"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <!--
            ComboBox: the built-in Aero/Generic template ignores our Background/Foreground
            setters on the closed-state TextBlock, leaving it dark text on dark background.
            We override the template with one that explicitly binds the inner TextBlock
            to the control's Foreground, and styles the toggle border + dropdown popup
            to fit the dark theme. Looks identical to a default ComboBox in normal use,
            but the selected text is now readable.
        -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="2">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow"
                                                          Fill="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                                          Margin="0,0,6,0"
                                                          Data="M 0,0 L 4,4 L 8,0 Z"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="6,3,20,3"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E1E2E"
                                            BorderBrush="#45475A"
                                            BorderThickness="1" CornerRadius="2">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input / output -->
        <GroupBox Grid.Row="0" Header="{x:Static res:Strings.GroupFiles}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.LblInput}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="InputBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" IsReadOnly="True"/>
                <Button Grid.Row="0" Grid.Column="2" Content="{x:Static res:Strings.BtnBrowse}" Click="BrowseInput_Click" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.LblOutput}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="OutputBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" IsReadOnly="True"/>
                <Button Grid.Row="1" Grid.Column="2" Content="{x:Static res:Strings.BtnBrowse}" Click="BrowseOutput_Click"/>
            </Grid>
        </GroupBox>

        <!-- Settings -->
        <GroupBox Grid.Row="1" Header="{x:Static res:Strings.GroupStereo}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.LblStrength}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <Slider x:Name="StrengthSlider" Grid.Row="0" Grid.Column="1"
                        Minimum="0.5" Maximum="6" Value="2.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Margin="0,0,8,4" ValueChanged="Setting_Changed"/>
                <TextBlock x:Name="StrengthLabel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                           Text="2.5 %" Margin="0,0,8,4" Width="48" TextAlignment="Right"/>
                <CheckBox x:Name="HevcCheck" Grid.Row="0" Grid.Column="3" Content="{x:Static res:Strings.ChkHevc}"
                          Foreground="#CDD6F4" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,4"/>

                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PresetSoft"   Content="{x:Static res:Strings.PresetSoft}"   Click="Preset_Click" Tag="1.5"
                            Background="#45475A" Foreground="#CDD6F4" Padding="8,4" Margin="0,0,4,4"/>
                    <Button x:Name="PresetNormal" Content="{x:Static res:Strings.PresetNormal}" Click="Preset_Click" Tag="2.5"
                            Background="#89B4FA" Padding="8,4" Margin="0,0,4,4"/>
                    <Button x:Name="PresetStrong" Content="{x:Static res:Strings.PresetStrong}" Click="Preset_Click" Tag="3.5"
                            Background="#45475A" Foreground="#CDD6F4" Padding="8,4" Margin="0,0,0,4"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.LblSmoothing}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="SmoothingSlider" Grid.Row="1" Grid.Column="1"
                        Minimum="0" Maximum="0.9" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Margin="0,0,8,0" ValueChanged="Setting_Changed"/>
                <TextBlock x:Name="SmoothingLabel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                           Text="0.0" Margin="0,0,8,0" Width="48" TextAlignment="Right"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="{x:Static res:Strings.LblSmoothingHint}" Foreground="#6C7086"
                           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Projection + Language -->
        <GroupBox Grid.Row="2" Header="{x:Static res:Strings.GroupProjection}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.LblFormat}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProjectionCombo" Grid.Column="1" Width="200"
                          SelectedIndex="1" VerticalAlignment="Center" Margin="0,0,16,0"
                          SelectionChanged="Projection_Changed">
                    <ComboBoxItem Content="{x:Static res:Strings.OptFlatSbs}"/>
                    <ComboBoxItem Content="{x:Static res:Strings.OptVr180}"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="{x:Static res:Strings.LblScreenFov}" VerticalAlignment="Center" Margin="0,0,8,0"
                           x:Name="FovText"/>
                <Slider x:Name="FovSlider" Grid.Column="3" Minimum="70" Maximum="175" Value="110"
                        TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,8,0"
                        VerticalAlignment="Center" ValueChanged="Setting_Changed"/>
                <TextBlock x:Name="FovLabel" Grid.Column="4" Text="110°" Width="48"
                           TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="5" Text="{x:Static res:Strings.LblLanguage}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="LanguageCombo" Grid.Column="6" Width="160" SelectionChanged="Language_Changed">
                    <ComboBoxItem Content="{x:Static res:Strings.OptLangAuto}" Tag="auto"/>
                    <ComboBoxItem Content="{x:Static res:Strings.OptLangRu}"   Tag="ru"/>
                    <ComboBoxItem Content="{x:Static res:Strings.OptLangEn}"   Tag="en"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Preview / info -->
        <Border Grid.Row="3" Background="#181825" CornerRadius="6" Padding="8" MinHeight="120">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="PreviewImage" Grid.Column="0" Stretch="Uniform" Margin="0,0,4,0"/>
                <Border Grid.Column="1" Background="#11111B" CornerRadius="4">
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="#6C7086" TextAlignment="Center"
                               Text="{x:Static res:Strings.InfoNoFile}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Progress -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar x:Name="ProgressBar" Height="18" Minimum="0" Maximum="100" Background="#313244"
                         Foreground="#A6E3A1"/>
            <TextBlock x:Name="StatusText" Text="{x:Static res:Strings.StatusReady}" Margin="0,6,0,0" Foreground="#A6ADC8"/>
        </StackPanel>

        <!-- Actions -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="PreviewButton" Content="{x:Static res:Strings.BtnPreview}" Click="Preview_Click" DockPanel.Dock="Left"/>
            <Button x:Name="OpenFolderButton" Content="{x:Static res:Strings.BtnOpenFolder}" Click="OpenFolder_Click"
                    DockPanel.Dock="Left" Margin="8,0,0,0" Background="#45475A" Foreground="#CDD6F4"/>
            <TextBlock x:Name="LangHint" Text="{x:Static res:Strings.LangRestartNote}" Foreground="#6C7086"
                       VerticalAlignment="Center" DockPanel.Dock="Left" Margin="16,0,0,0"/>
            <Button x:Name="ConvertButton" Content="{x:Static res:Strings.BtnConvert}" Click="Convert_Click" DockPanel.Dock="Right"
                    Background="#A6E3A1" Padding="24,6"/>
            <Button x:Name="CancelButton" Content="{x:Static res:Strings.BtnCancel}" Click="Cancel_Click" DockPanel.Dock="Right"
                    Background="#F38BA8" IsEnabled="False" Margin="8,0"/>
        </DockPanel>
    </Grid>
</Window>
