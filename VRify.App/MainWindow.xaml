<Window x:Class="VRify.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRify — 2D → VR SBS 180" Height="640" Width="900"
        Background="#1E1E2E" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#6C7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#89B4FA"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input / output -->
        <GroupBox Grid.Row="0" Header="Файлы" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Вход:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="InputBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" IsReadOnly="True"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Обзор…" Click="BrowseInput_Click" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Выход:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="OutputBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" IsReadOnly="True"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Обзор…" Click="BrowseOutput_Click"/>
            </Grid>
        </GroupBox>

        <!-- Settings -->
        <GroupBox Grid.Row="1" Header="Настройки стерео" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Сила глубины:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <Slider x:Name="StrengthSlider" Grid.Row="0" Grid.Column="1"
                        Minimum="0.5" Maximum="6" Value="2.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Margin="0,0,8,4" ValueChanged="Setting_Changed"/>
                <TextBlock x:Name="StrengthLabel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                           Text="2.5 %" Margin="0,0,8,4" Width="48" TextAlignment="Right"/>
                <CheckBox x:Name="HevcCheck" Grid.Row="0" Grid.Column="3" Content="HEVC (H.265)"
                          Foreground="#CDD6F4" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,4"/>

                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PresetSoft"   Content="Слабо"   Click="Preset_Click" Tag="1.5"
                            Background="#45475A" Foreground="#CDD6F4" Padding="8,4" Margin="0,0,4,4"/>
                    <Button x:Name="PresetNormal" Content="Стандарт" Click="Preset_Click" Tag="2.5"
                            Background="#89B4FA" Padding="8,4" Margin="0,0,4,4"/>
                    <Button x:Name="PresetStrong" Content="Сильно"  Click="Preset_Click" Tag="3.5"
                            Background="#45475A" Foreground="#CDD6F4" Padding="8,4" Margin="0,0,0,4"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Сглаживание:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="SmoothingSlider" Grid.Row="1" Grid.Column="1"
                        Minimum="0" Maximum="0.9" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Margin="0,0,8,0" ValueChanged="Setting_Changed"/>
                <TextBlock x:Name="SmoothingLabel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                           Text="0.0" Margin="0,0,8,0" Width="48" TextAlignment="Right"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="(против мерцания, 0 = максимум стерео)" Foreground="#6C7086"
                           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Projection -->
        <GroupBox Grid.Row="2" Header="Проекция" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Формат:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProjectionCombo" Grid.Column="1" Width="180"
                          SelectedIndex="1" VerticalAlignment="Center" Margin="0,0,16,0"
                          SelectionChanged="Projection_Changed">
                    <ComboBoxItem Content="Плоский SBS (экран)"/>
                    <ComboBoxItem Content="VR180 equirect (очки)"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="Экран:" VerticalAlignment="Center" Margin="0,0,8,0"
                           x:Name="FovText"/>
                <Slider x:Name="FovSlider" Grid.Column="3" Minimum="70" Maximum="175" Value="110"
                        TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,8,0"
                        VerticalAlignment="Center" ValueChanged="Setting_Changed"/>
                <TextBlock x:Name="FovLabel" Grid.Column="4" Text="110°" Width="48"
                           TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="6" Text="(поле зрения виртуального экрана)" Foreground="#6C7086"
                           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Preview / info -->
        <Border Grid.Row="3" Background="#181825" CornerRadius="6" Padding="8" MinHeight="120">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="PreviewImage" Grid.Column="0" Stretch="Uniform" Margin="0,0,4,0"/>
                <Border Grid.Column="1" Background="#11111B" CornerRadius="4">
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="#6C7086" TextAlignment="Center"
                               Text="Перетащите видеофайл в окно&#x0a;или нажмите «Обзор…» выше"/>
                </Border>
            </Grid>
        </Border>

        <!-- Progress -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar x:Name="ProgressBar" Height="18" Minimum="0" Maximum="100" Background="#313244"
                         Foreground="#A6E3A1"/>
            <TextBlock x:Name="StatusText" Text="Готово" Margin="0,6,0,0" Foreground="#A6ADC8"/>
        </StackPanel>

        <!-- Actions -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="PreviewButton" Content="Превью" Click="Preview_Click" DockPanel.Dock="Left"/>
            <Button x:Name="OpenFolderButton" Content="Открыть папку" Click="OpenFolder_Click"
                    DockPanel.Dock="Left" Margin="8,0,0,0" Background="#45475A" Foreground="#CDD6F4"/>
            <Button x:Name="ConvertButton" Content="Конвертировать" Click="Convert_Click" DockPanel.Dock="Right"
                    Background="#A6E3A1" Padding="24,6"/>
            <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" DockPanel.Dock="Right"
                    Background="#F38BA8" IsEnabled="False" Margin="8,0"/>
        </DockPanel>
    </Grid>
</Window>
